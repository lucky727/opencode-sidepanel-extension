{
  "manifest_version": 3,
  "name": "OpenCode Sidepanel Extension",
  "description": "Opens the OpenCode web interface in Brave's native Side Panel, with tab context and AI browsing glow.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "activeTab", "tabs", "scripting", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "OpenCode",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:4096/*", "http://localhost:4096/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}